<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Page</title>
</head>
<body>

    <header>
        <h1>Welcome to Our Store</h1>
        <p>Discover our amazing products at the best prices.</p>
    </header>

    <!-- Connected Discount Section -->
    <section id="discount">
        <h2>Special Offers <span style="background-color: #e74c3c; color: white; padding: 3px 8px; border-radius: 3px;">50% OFF</span></h2>
        <p>Use code <strong>MIDTERM50</strong> at checkout to get half off your first order!</p>
    </section>

</body>
</html>
